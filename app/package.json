{
  "name": "meal-planner-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local browser app for the meal planner: Claude embedded via the Agent SDK — plan, approve, shop, log, review from any device",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "selftest": "tsx scripts/selftest.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.283",
    "express": "^4.19.2",
    "marked": "^12.0.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
